generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  engineType = "binary"  
}

datasource db {
  provider = "postgresql"
  //url = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstname String
  lastname  String
  password  String
  dob       DateTime?
  createdAt DateTime @default(now())
}